<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RhinoSpatial.Sandbox</AssemblyName>
    <RootNamespace>RhinoSpatial.Sandbox</RootNamespace>
    <Product>RhinoSpatial</Product>
    <Title>RhinoSpatial Sandbox</Title>
    <BaseOutputPath>sandbox/bin/</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="RhinoSpatial.Core/**/*.cs" />
    <Compile Remove="RhinoSpatial/**/*.cs" />
    <Compile Include="RhinoSpatial/Google3dTilesGeographicBounds.cs" Link="Google3dTilesGeographicBounds.cs" />
    <Compile Include="RhinoSpatial/Google3dTilesElevationBaseline.cs" Link="Google3dTilesElevationBaseline.cs" />
    <Compile Include="RhinoSpatial/Google3dTilesRefinementSelector.cs" Link="Google3dTilesRefinementSelector.cs" />
    <Compile Include="RhinoSpatial/Google3dTilesTileDescriptor.cs" Link="Google3dTilesTileDescriptor.cs" />
    <Compile Include="RhinoSpatial/SpatialElevationBaselineCache.cs" Link="SpatialElevationBaselineCache.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="RhinoSpatial.Core/RhinoSpatial.Core.csproj" />
  </ItemGroup>
</Project>
